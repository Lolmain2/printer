{
  "name": "scream-coach",
  "productName": "Scream Coach",
  "version": "1.1.0",
  "description": "Vocal warm-ups that build up to fry, false cord and other extreme vocal techniques.",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.screamcoach.app",
    "productName": "Scream Coach",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "curriculum.js",
      "progress.js",
      "pitch.js",
      "updates.js",
      "devices.js",
      "pitch-trainer.js",
      "audio.js",
      "pitch-tab.js",
      "desktop/main.js",
      "desktop/preload.js",
      "desktop/updater.js",
      "desktop/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "ScreamCoach-Setup-${version}.${ext}",
      "shortcutName": "Scream Coach",
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Lolmain2",
        "repo": "printer",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
